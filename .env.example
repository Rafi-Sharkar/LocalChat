# Redis Connection URL
REDIS_URL=redis://127.0.0.1:6379

# Server Configuration
PORT=3000
HOSTNAME=0.0.0.0

# Chat & Session Expiration Limits
MAX_MESSAGES_PER_CHAT=1000
CHAT_TTL_SECONDS=86400
USER_SESSION_TTL_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=20

# Message & User Validation
MAX_MESSAGE_LENGTH=2000
MAX_NICKNAME_LENGTH=30
MIN_NICKNAME_LENGTH=2

# Rate Limiting
MESSAGE_RATE_LIMIT=20
MESSAGE_RATE_WINDOW_SECONDS=10
JOIN_RATE_LIMIT=5
JOIN_RATE_WINDOW_SECONDS=60
NICKNAME_CHANGE_RATE_LIMIT=5
NICKNAME_CHANGE_WINDOW_SECONDS=60

# Next.js Public
NEXT_PUBLIC_APP_NAME="LAN Chat"
